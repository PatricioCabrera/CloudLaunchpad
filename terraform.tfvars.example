# Copy to terraform.tfvars and adjust for your fork.
# terraform.tfvars is gitignored — it's the mechanism for local overrides,
# not because these values are secret.

aws_region  = "us-east-1"
github_org  = "PatricioCabrera"
github_repo = "CloudLaunchpad"

# Off by default so CI's apply-on-merge never leaves an instance running.
# Set true locally to bring up the EC2 instance — and destroy it before you close.
# enable_ec2 = true

# The VPC range comes from the platform, in SSM at
# /platform/ip-allocations/cloudlaunchpad/cidr. Subnets are carved from it;
# override only to change their sizes or positions.
# subnets = {
#   "public-a"  = { newbits = 6, netnum = 0, public = true }
#   "public-b"  = { newbits = 6, netnum = 1, public = true }
#   "private-a" = { newbits = 3, netnum = 1, public = false }
#   "private-b" = { newbits = 3, netnum = 2, public = false }
# }
